<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ONCore" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#00BCD4</item>
        <item name="colorPrimaryDark">#1A1A1A</item>
        <item name="colorAccent">#00BCD4</item>
        <item name="android:windowBackground">@color/dashboard_background</item>
    </style>

    <style name="DashboardTabTextAppearance" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">14sp</item>

        <item name="fontFamily">sans-serif</item>

        <item name="android:textAllCaps">false</item>

    </style>

    <style name="DashboardEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#555555</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>