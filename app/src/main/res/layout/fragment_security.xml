<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_security"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ACCOUNT SECURITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account Security"
                android:textSize="22sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-light" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/ic_security"
                app:tint="#FFFFFFFF" />

        </LinearLayout>

        <!-- SmartAuth -->
        <LinearLayout
            android:id="@+id/row_smartauth_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_shield"
                app:tint="#FFFFFFFF"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartAuth Protection"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage which apps can use ON Auth"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#FF444444" android:visibility="gone" />

        <!-- Password Vault -->
        <LinearLayout
            android:id="@+id/row_password_vault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_key"
                app:tint="#FFFFFFFF"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password Vault"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add new passwords or see existing"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#FF444444" android:visibility="gone" />

        <!-- Sessions -->
        <LinearLayout
            android:id="@+id/row_sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_sessions"
                app:tint="#FFFFFFFF"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Sessions"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Devices currently signed in to your account"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF444444"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:visibility="gone" />

        <!-- ACTIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Account Actions"
            android:textColor="#FFFF5555"
            android:textSize="22sp"
            android:fontFamily="sans-serif-light" />

        <LinearLayout
            android:id="@+id/row_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_logout"
                app:tint="#FFFF5555"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Out"
                    android:textSize="16sp"
                    android:textColor="#FFFF5555" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign out from this device"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFF5555" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#FF444444" />

        <!-- Delete Account -->
        <LinearLayout
            android:id="@+id/row_delete_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_trash_can"
                app:tint="#FFFF5555"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete account"
                    android:textSize="16sp"
                    android:textColor="#FFFF5555" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permanently remove your ON account and data"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFF5555" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
