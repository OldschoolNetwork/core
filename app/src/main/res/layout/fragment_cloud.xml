<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_cloud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ON CLOUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ON Cloud"
                android:textSize="22sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-light" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/ic_cloud"
                app:tint="#FFFFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Storage used"
                android:textSize="13sp"
                android:textColor="#FFCCCCCC" />
            <TextView
                android:id="@+id/tv_storage_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB / 512 MB"
                android:textSize="13sp"
                android:textColor="#FF00BCD4" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_storage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF00BCD4"
            android:progressBackgroundTint="#FF444444"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Free tier: 512 MB · Upgrade coming soon"
            android:textSize="11sp"
            android:textColor="#FF666666"
            android:layout_marginBottom="16dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#FF444444" android:layout_marginBottom="16dp" />

        <!-- GAME SAVES -->
        <LinearLayout
            android:id="@+id/row_manage_saves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_gamehome"
                app:tint="#FFFFFFFF"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage game saves"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View, download or delete cloud saves"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#FF444444" />

        <!-- BACKUPS -->
        <LinearLayout
            android:id="@+id/row_backup_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_backup"
                app:tint="#FFFFFFFF"
                android:layout_marginRight="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back up now"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last backup: never"
                    android:textSize="12sp"
                    android:textColor="#FF888888" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
